# Copia este archivo a .env y rellena según el entorno.
# NO subas .env a git.

# --- Opción A: Neon (nube, equipo) — ver DATABASE_NEON.md ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX-pooler.region.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=cambiar_por_password_neon

# --- Opción B: Postgres local con Docker — ver backend/DOCKER_DB.md ---
# docker compose up -d  (desde la raíz del repo)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gopoli
SPRING_DATASOURCE_USERNAME=gopoli
SPRING_DATASOURCE_PASSWORD=gopoli
